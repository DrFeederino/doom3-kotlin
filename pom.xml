<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.drfeederino</groupId>
    <artifactId>doom3-kotlin</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <profiles>
        <profile>
            <id>lwjgl-natives-windows</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <lwjgl.natives>natives-windows</lwjgl.natives>
                <launcher.unix.skip>true</launcher.unix.skip>
                <launcher.windows.skip>false</launcher.windows.skip>
            </properties>
        </profile>

        <profile>
            <id>lwjgl-natives-macos-intel</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>x86_64</arch>
                </os>
            </activation>
            <properties>
                <lwjgl.natives>natives-macos</lwjgl.natives>
                <launcher.jvm.opts>-XstartOnFirstThread</launcher.jvm.opts>
            </properties>
        </profile>

        <profile>
            <id>lwjgl-natives-macos-arm64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <lwjgl.natives>natives-macos-arm64</lwjgl.natives>
                <launcher.jvm.opts>-XstartOnFirstThread</launcher.jvm.opts>
            </properties>
        </profile>
    </profiles>
    <properties>
        <lwjgl.version>3.4.3</lwjgl.version>

        <junit.version>6.1.3</junit.version>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <kotlin.version>2.4.20</kotlin.version>
        <maven.compiler.target>25</maven.compiler.target>
        <maven.compiler.source>25</maven.compiler.source>
        <!-- Launcher generation at package time (antrun): the lwjgl-natives-windows
             profile flips these to produce the .bat instead of the .sh. -->
        <launcher.unix.skip>false</launcher.unix.skip>
        <launcher.windows.skip>true</launcher.windows.skip>
        <!-- Extra JVM option baked into the generated unix launcher; the macOS profiles
             set -XstartOnFirstThread (GLFW requires the main thread there). -->
        <launcher.jvm.opts></launcher.jvm.opts>
    </properties>
    
    <build>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <configuration>
                    <jvmTarget>25</jvmTarget>
                </configuration>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <sourceDirs>
                                <sourceDir>src/main/kotlin</sourceDir>
                                <sourceDir>src/main/java</sourceDir>
                                <sourceDir>src/main/resources</sourceDir>
                            </sourceDirs>
                        </configuration>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                        <configuration>
                            <sourceDirs>
                                <source>src/test/java</source>
                                <source>src/test/kotlin</source>
                                <source>src/test/resources</source>
                            </sourceDirs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>neo.sys.Win_mainKt</mainClass>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>libs/</classpathPrefix>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <!-- Runtime dependencies (incl. LWJGL natives for the active platform)
                             next to the jar, matching the manifest Class-Path prefix `libs/`. -->
                        <id>copy-runtime-libs</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/libs</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <!-- Generates the launcher script in the project root after packaging
                             and tells the user how to play. Skipped on Windows. -->
                        <id>install-launcher-unix</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${launcher.unix.skip}</skip>
                            <target>
                                <echo file="${project.basedir}/run-game.sh"><![CDATA[#!/bin/sh
# DOOM 3 Kotlin launcher - generated by `mvn package`; edits are overwritten each build.
# Runs the already-built jar - re-run `mvn package` only after changing code.
# Extra console arguments can be appended to the call.

DIR=$(dirname "$0")

JAR=$(ls "$DIR"/target/doom3-kotlin-*.jar 2>/dev/null | head -n 1)
if [ ! -f "$JAR" ]; then
    echo "No built jar found in target/ - run 'mvn package' first." >&2
    exit 1
fi

if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    JAVA="$JAVA_HOME/bin/java"
else
    JAVA=java
fi

exec "$JAVA" @JVM_OPTS@ -jar "$JAR" "+set com_allowConsole 1 +set si_pure 0" "$@"
]]></echo>
                                <replace file="${project.basedir}/run-game.sh" token="@JVM_OPTS@"
                                         value="${launcher.jvm.opts}"/>
                                <chmod file="${project.basedir}/run-game.sh" perm="755" failonerror="false"/>
                                <echo message=""/>
                                <echo message="===================== DOOM 3 Kotlin ====================="/>
                                <echo message=" Build complete. To play, run ./run-game.sh from the project root."/>
                                <echo message=" It reuses the built jar - only re-run 'mvn package' after code changes."/>
                                <echo message="=========================================================="/>
                                <echo message=""/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- Windows counterpart of install-launcher-unix; skipped elsewhere. -->
                        <id>install-launcher-windows</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${launcher.windows.skip}</skip>
                            <target>
                                <echo file="${project.basedir}/run-game.bat"><![CDATA[@ECHO OFF
SETLOCAL
SET "DIR=%~dp0"

REM DOOM 3 Kotlin launcher - generated by `mvn package`; edits are overwritten each build.
REM Runs the already-built jar - re-run `mvn package` only after changing code.
REM Extra console arguments can be appended to the call.

SET "JAR="
FOR %%F IN ("%DIR%target\doom3-kotlin-*.jar") DO SET "JAR=%%~fF"
IF NOT DEFINED JAR (
    ECHO No built jar found in target\ - run "mvn package" first. 1>&2
    EXIT /B 1
)

IF DEFINED JAVA_HOME (SET "JAVA=%JAVA_HOME%\bin\java.exe") ELSE (SET "JAVA=java")

"%JAVA%" -jar "%JAR%" "+set com_allowConsole 1 +set si_pure 0" %*
]]></echo>
                                <fixcrlf file="${project.basedir}/run-game.bat" eol="dos"/>
                                <echo message=""/>
                                <echo message="===================== DOOM 3 Kotlin ====================="/>
                                <echo message=" Build complete. To play, run run-game.bat from the project root."/>
                                <echo message=" It reuses the built jar - only re-run 'mvn package' after code changes."/>
                                <echo message="=========================================================="/>
                                <echo message=""/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
        
    <dependencies>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl</artifactId>
            <version>${lwjgl.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-glfw</artifactId>
            <version>${lwjgl.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-openal</artifactId>
            <version>${lwjgl.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-opengl</artifactId>
            <version>${lwjgl.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-stb</artifactId>
            <version>${lwjgl.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl</artifactId>
            <version>${lwjgl.version}</version>
            <classifier>${lwjgl.natives}</classifier>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-glfw</artifactId>
            <version>${lwjgl.version}</version>
            <classifier>${lwjgl.natives}</classifier>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-openal</artifactId>
            <version>${lwjgl.version}</version>
            <classifier>${lwjgl.natives}</classifier>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-opengl</artifactId>
            <version>${lwjgl.version}</version>
            <classifier>${lwjgl.natives}</classifier>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-stb</artifactId>
            <version>${lwjgl.version}</version>
            <classifier>${lwjgl.natives}</classifier>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>
    </dependencies>
</project>